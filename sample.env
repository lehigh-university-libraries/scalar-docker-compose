# Absolute path to a separate books-only directory; never the live production tree.
SCALAR_DATA_DIR=/opt/scalar-books
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443

# Local host HAProxy; use its hostname instead when the proxy is remote.
SCALAR_DB_HOSTNAME=host.docker.internal
SCALAR_DB_USERNAME=scalar
SCALAR_DB_DATABASE=scalar

SCALAR_USE_LDAP=true
SCALAR_LDAP_SERVER=ldaps://nis.cc.lehigh.edu
SCALAR_LDAP_PORT=636
SCALAR_LDAP_BASEDN=dc=lehigh,dc=edu

SCALAR_LDAP_EMAIL_DOMAIN=lehigh.edu
SCALAR_LDAP_OBJECT_CLASS=person

SCALAR_MAX_LOGIN_ATTEMPTS=10
SCALAR_LOGIN_PENALTY_SECONDS=60
# Persistent source subnet for the host UFW rule; choose a non-overlapping range.
SCALAR_NETWORK_SUBNET=172.18.0.0/16

# Fatal/error PHP categories only; 32767 enables warnings/notices/deprecations too.
SCALAR_PHP_ERROR_REPORTING=4437
